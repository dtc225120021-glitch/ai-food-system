<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/logo_ai_food"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@drawable/logo_ai_food"
        android:supportsRtl="true"
        android:theme="@style/Theme.AIFood">
        <activity
            android:name=".presentation.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.AIFood">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".presentation.auth.AuthActivity"
            android:exported="true" />

        <activity
            android:name=".presentation.main.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AIFood" />

        <activity
            android:name=".presentation.config.UserConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.AIFood" />

        <activity
            android:name=".presentation.capture.CaptureActivity"
            android:exported="true" />

        <activity
            android:name=".presentation.capture.CropImageActivity"
            android:exported="true" />

        <activity
            android:name=".presentation.result.ResultActivity"
            android:exported="true" />

        <activity
            android:name=".presentation.profile.ProfileActivity"
            android:exported="true" />

        <activity
            android:name=".presentation.history.HistoryDetailActivity"
            android:exported="true" />
    </application>

</manifest>